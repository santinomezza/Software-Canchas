# ---------------------------------------------------------------------------
# Entorno — copiar a `.env.local` y completar.
# Ninguna de estas variables es obligatoria para levantar el sitio: sin ellas
# el producto funciona en modo sandbox (pagos sin cobrar, leads por consola).
# ---------------------------------------------------------------------------

# URL pública del sitio. Se usa para canonical, sitemap, OG y URLs de retorno
# del checkout de Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marca. El nombre por defecto es "cancha".
NEXT_PUBLIC_BRAND_NAME=cancha
NEXT_PUBLIC_BRAND_LEGAL=Cancha Software S.A.S.
NEXT_PUBLIC_CONTACT_EMAIL=hola@cancha.app
NEXT_PUBLIC_CONTACT_PHONE=

# Base de datos SQLite (driver nativo de Node: node:sqlite).
# Ruta relativa al root del proyecto.
DATABASE_PATH=./data/cancha.db

# Envío de emails (Resend). Sin esto los pedidos de prueba y las
# suscripciones al roadmap se registran solo en los logs del servidor.
RESEND_API_KEY=
TRIAL_LEADS_EMAIL=
TRIAL_FROM_EMAIL="cancha <onboarding@cancha.app>"
ROADMAP_LEADS_EMAIL=

# Mercado Pago. Sin `MERCADO_PAGO_ACCESS_TOKEN` el checkout corre en modo
# sandbox: la reserva queda aprobada pero no se cobra nada.
#
# Este es el token por defecto de la plataforma. Cada complejo puede pegar su
# propio access token desde Panel → Configuración → Integraciones: ese token
# tiene prioridad y se guarda cifrado en la base.
MERCADO_PAGO_ACCESS_TOKEN=

# WhatsApp (Cloud API de Meta): token por defecto de la plataforma.
# Cada complejo también puede configurar el suyo desde Configuración →
# Integraciones, y el aviso de cada turno se envía a SU propio número.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_GRAPH_VERSION=v21.0

# Token de verificación del webhook de WhatsApp (el que elegís vos).
WHATSAPP_VERIFY_TOKEN=

# LLM opcional para interpretar texto libre ("mañana a la noche pádel").
# Sin esta clave manda el parser por reglas: el bot funciona igual.
ANTHROPIC_API_KEY=
BOT_LLM_MODEL=claude-haiku-4-5-20251001

# Cifrado de los secretos que guarda cada usuario (tokens de Mercado Pago y
# WhatsApp). Si no se define, se genera una clave en `.data/integration.key`.
# En Vercel hay que definirla sí o sí, porque el filesystem es efímero.
INTEGRATION_ENCRYPTION_KEY=

# Video de la demo (opcional). Si no se define, el reproductor muestra un
# recorrido interactivo del panel.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Analítica sin cookies (Plausible). El script solo se carga si el dominio
# está definido, y los eventos solo se envían tras aceptar el aviso de cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
