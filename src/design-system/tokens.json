{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "cancha",
    "version": "1.0.0",
    "description": "Design tokens de cancha. El mismo archivo alimenta las variables CSS de globals.css y se importa a Figma Variables (colección con modos Light y Dark).",
    "figmaCollection": "cancha / Foundations",
    "modes": ["Light", "Dark"]
  },
  "color": {
    "background": {
      "base": { "light": "#F6F4EF", "dark": "#07110F" },
      "surface-1": { "light": "#FFFFFF", "dark": "#0D1B18" },
      "surface-2": { "light": "#FFFFFF", "dark": "#13261F" },
      "surface-3": { "light": "#EFEBE2", "dark": "#1B3129" }
    },
    "accent": {
      "base": { "light": "#12B981", "dark": "#2EE59D" },
      "strong": { "light": "#0C7A55", "dark": "#2EE59D" },
      "contrast": { "light": "#FFFFFF", "dark": "#04140E" },
      "soft": { "light": "rgba(18, 185, 129, 0.10)", "dark": "rgba(46, 229, 157, 0.12)" }
    },
    "premium": {
      "gold": { "light": "#8A6A24", "dark": "#D9B870" },
      "gold-soft": { "light": "rgba(138, 106, 36, 0.10)", "dark": "rgba(217, 184, 112, 0.12)" }
    },
    "ink": {
      "primary": { "light": "#1A1F1D", "dark": "#E9F0ED" },
      "secondary": { "light": "#4A544F", "dark": "#9FB3AC" },
      "muted": { "light": "#68766F", "dark": "#7C918A" }
    },
    "line": {
      "subtle": { "light": "rgba(26, 31, 29, 0.12)", "dark": "rgba(233, 240, 237, 0.10)" },
      "strong": { "light": "rgba(26, 31, 29, 0.22)", "dark": "rgba(233, 240, 237, 0.18)" }
    },
    "status": {
      "success": { "light": "#0C7A55", "dark": "#2EE59D" },
      "warning": { "light": "#8A5A0B", "dark": "#F0B44B" },
      "danger": { "light": "#A63321", "dark": "#F2705B" }
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px",
    "40": "160px",
    "48": "192px"
  },
  "radii": {
    "xs": "6px",
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "xl": "28px",
    "2xl": "36px",
    "pill": "999px"
  },
  "typography": {
    "font-family": {
      "display": "'Fraunces', 'Iowan Old Style', Georgia, serif",
      "sans": "'Inter Tight', 'Inter', ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, 'SFMono-Regular', 'Menlo', monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem)",
      "xl": "clamp(1.375rem, 1.22rem + 0.72vw, 1.625rem)",
      "2xl": "clamp(1.75rem, 1.45rem + 1.35vw, 2.25rem)",
      "3xl": "clamp(2.125rem, 1.72rem + 2.1vw, 3.125rem)",
      "4xl": "clamp(2.75rem, 1.92rem + 3.6vw, 4.5rem)",
      "5xl": "clamp(3.25rem, 2.05rem + 5.3vw, 6rem)"
    },
    "line-height": {
      "tight": "1.05",
      "snug": "1.2",
      "normal": "1.5",
      "relaxed": "1.65"
    },
    "tracking": {
      "tightest": "-0.045em",
      "tighter": "-0.03em",
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.04em",
      "widest": "0.14em"
    }
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.16), 0 1px 1px rgba(0, 0, 0, 0.08)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.18), 0 2px 4px rgba(0, 0, 0, 0.12)",
    "lg": "0 18px 40px -12px rgba(0, 0, 0, 0.45), 0 6px 16px -8px rgba(0, 0, 0, 0.35)",
    "xl": "0 40px 80px -24px rgba(0, 0, 0, 0.55), 0 12px 28px -12px rgba(0, 0, 0, 0.4)",
    "glow": "0 0 0 1px rgba(46, 229, 157, 0.22), 0 14px 44px -10px rgba(46, 229, 157, 0.34)"
  },
  "motion": {
    "ease": [0.22, 1, 0.36, 1],
    "ease-out": [0.16, 1, 0.3, 1],
    "duration": { "fast": 0.22, "base": 0.45, "slow": 0.7 },
    "distance": { "sm": 12, "md": 18, "lg": 24 }
  },
  "layout": {
    "container": "80rem",
    "container-wide": "90rem",
    "gutter": "clamp(1.25rem, 0.9rem + 1.8vw, 2.5rem)",
    "section-y": "clamp(5rem, 3.6rem + 6.2vw, 10rem)",
    "columns": 12
  }
}
